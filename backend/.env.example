# PaperScout — trợ lý research cá nhân chạy local.
# Copy file này thành backend/.env rồi điền key. run.py sẽ tự copy nếu chưa có.

# ── Bắt buộc: 1 trong 2 provider LLM ─────────────────────────────────────────
# Dùng OpenAI (mặc định):
OPENAI_API_KEY=sk-...
# Hoặc dùng Gemini (đặt llm.provider = "gemini" trong config.toml):
# GEMINI_API_KEY=...

# ── Tùy chọn ─────────────────────────────────────────────────────────────────
# Tăng rate limit Semantic Scholar:
# SEMANTIC_SCHOLAR_API_KEY=

# DB paper dùng CHUNG đã được nhúng sẵn trong repo (agent/tools/shared_supabase.py),
# nên KHÔNG cần cấu hình gì để chạy. Chỉ đặt các biến dưới nếu muốn trỏ sang
# Supabase RIÊNG của bạn (ghi đè DB chung):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # (hoặc SUPABASE_ANON_KEY cho key JWT cũ)
#
# Secret key CHỈ dùng cho setup 1 lần (tạo bucket + bảng qua scripts/setup_supabase.py).
# Đây là key admin (bỏ qua RLS) — KHÔNG BAO GIỜ commit vào repo:
# SUPABASE_SECRET_KEY=sb_secret_...
